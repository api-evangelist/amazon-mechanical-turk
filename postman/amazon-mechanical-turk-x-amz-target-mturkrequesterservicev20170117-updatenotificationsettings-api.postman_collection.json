              "mode": "raw",
              "raw": "{\n  \"HITTypeId\": \"FDI6\",\n  \"Notification\": {\n    \"Destination\": \"<string>\",\n    \"Transport\": \"Email\",\n    \"Version\": \"<string>\",\n    \"EventTypes\": [\n      \"AssignmentAccepted\",\n      \"HITDisposed\"\n    ]\n  },\n  \"Active\": \"<boolean>\"\n}",
